---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

/** Alt text per file name; a file not listed here is not shown. */
const CAPTIONS: Record<string, string> = {
  "on-air": "The main window with a track on air and the playlist queued",
  library: "The music library with search and the track list",
  "cue-editor": "The cue editor with five markers on a two-strip waveform",
};

const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/screenshots/*.{png,jpg,webp}",
  { eager: true },
);
const shots = Object.keys(CAPTIONS).flatMap((name) => {
  const path = Object.keys(files).find((file) =>
    file.includes(`/screenshots/${name}.`),
  );
  const image = path && files[path]?.default;
  return image ? [{ image, alt: CAPTIONS[name]! }] : [];
});
---

{
  shots.length > 0 && (
    <section class="section screenshots">
      {shots.map(({ image, alt }) => (
        <Image src={image} alt={alt} widths={[640, 1280, image.width]} />
      ))}
    </section>
  )
}
