---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

/** Alt text per file name; a file not listed here is not shown. */
const CAPTIONS: Record<string, string> = {
  "on-air":
    "The main window: a track on air with its waveform, the music library, and the upcoming playlist",
  library:
    "The library filtered by a search, with one track's tags, measured tempo and key shown in a popover",
  "cue-points":
    "The cue point editor: five markers on a two-strip waveform, with nudge and audition controls",
};

const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/screenshots/*.{png,jpg,webp}",
  { eager: true },
);
const shots = Object.keys(CAPTIONS).flatMap((name) => {
  const path = Object.keys(files).find((file) =>
    file.includes(`/screenshots/${name}.`),
  );
  const image = path && files[path]?.default;
  return image ? [{ image, alt: CAPTIONS[name]! }] : [];
});
---

{
  shots.length > 0 && (
    <section class="section screenshots">
      {shots.map(({ image, alt }) => (
        <Image
          src={image}
          alt={alt}
          widths={[640, 1280, 2176]}
          sizes="(max-width: 48rem) 100vw, 68rem"
        />
      ))}
    </section>
  )
}
