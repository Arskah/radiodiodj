{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RadiodioDJ",
  "version": "0.25.1",
  "identifier": "com.radiodiodj",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm vite dev",
    "beforeBuildCommand": "pnpm vite build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RadiodioDJ",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0NzE3MDIxNzc3NkVDMUEKUldRYTdIWjNJWEJ4OUFqUFNaNXpZRFlCWFZVOENJSGVuSzRSTmJnS3Exb3VIWThhWmhpSWJzbFEK",
      "endpoints": ["https://radiodiodj.org/update.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
