{
  "name": "Daylight",
  "base": "light",
  "notes": [
    "A built-in theme. Every token in the contract is set, because a built-in is",
    "what an incomplete theme falls back to.",
    "Values are #rgb, #rrggbb, #rrggbbaa, rgb(), rgba(), hsl(), hsla(), or the",
    "keyword transparent. Nothing else."
  ],
  "tokens": {
    "--surface": "#fdfcff",
    "--surface-dim": "#f0eff4",
    "--surface-bright": "#ffffff",
    "--surface-container-lowest": "#ffffff",
    "--surface-container-low": "#f7f6fb",
    "--surface-container": "#f1f0f6",
    "--surface-container-high": "#eae9f0",
    "--surface-container-highest": "#e3e2ea",
    "--surface-variant": "#e3e2ea",
    "--background": "#fdfcff",
    "--on-surface": "#1a1b21",
    "--on-surface-variant": "#45464f",
    "--outline": "#767680",
    "--outline-variant": "#c6c5d0",
    "--primary": "#2e4bcc",
    "--on-primary": "#ffffff",
    "--primary-container": "#2e5bff",
    "--on-primary-container": "#ffffff",
    "--inverse-primary": "#b8c3ff",
    "--secondary": "#7a29b8",
    "--on-secondary": "#ffffff",
    "--secondary-container": "#6f00be",
    "--on-secondary-container": "#f5e6ff",
    "--tertiary": "#ffb59b",
    "--tertiary-container": "#c24100",
    "--on-warning-container": "#3a1a00",
    "--error": "#b3261e",
    "--on-error": "#ffffff",
    "--error-container": "#f9dedc",
    "--on-error-container": "#410e0b",
    "--led-highlight": "#ff8a80",
    "--shadow-color": "#3c3c48",
    "--scrim": "rgba(28, 27, 34, 0.4)",
    "--on-toggle-knob": "#ffffff",
    "--cue-in-color": "#1a7f3c",
    "--fade-in-color": "#0369a1",
    "--fade-out-color": "#a16207",
    "--cue-out-color": "#be123c",
    "--next-start-color": "#7a29b8",
    "--on-marker": "#ffffff"
  }
}
