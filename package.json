{
  "name": "radiodiodj",
  "version": "0.21.2",
  "description": "Radio station music player",
  "author": {
    "name": "Aarni Halinen",
    "email": "radiodiodj@aarnihalinen.fi"
  },
  "homepage": "https://github.com/Arskah/radiodiodj#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arskah/radiodiodj.git"
  },
  "bugs": {
    "url": "https://github.com/Arskah/radiodiodj/issues"
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "svelte-check": "svelte-check",
    "typecheck": "pnpm svelte-check && pnpm typecheck:node && pnpm typecheck:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "test": "vitest",
    "e2e": "wdio run e2e/wdio.conf.ts",
    "e2e:docker": "docker compose -f docker-compose.e2e.yml run --build --rm e2e",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "*.{ts,mts}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-log": "2.9.1",
    "material-symbols": "0.47.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/mocha": "10.0.10",
    "@types/node": "25.9.7",
    "@vitest/coverage-v8": "5.0.1",
    "@wdio/cli": "9.31.9",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.9",
    "@wdio/mocha-framework": "9.31.9",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/types": "9.31.2",
    "eslint": "10.11.0",
    "husky": "9.1.7",
    "jsdom": "30.1.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "webdriverio": "9.31.9"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
