{
  "name": "radiodiodj",
  "version": "0.15.0",
  "description": "Radio station music player",
  "author": {
    "name": "Aarni Halinen",
    "email": "radiodiodj@aarnihalinen.fi"
  },
  "homepage": "https://github.com/Arskah/radiodiodj#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arskah/radiodiodj.git"
  },
  "bugs": {
    "url": "https://github.com/Arskah/radiodiodj/issues"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "svelte-check": "svelte-check",
    "typecheck": "pnpm svelte-check && pnpm typecheck:node && pnpm typecheck:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "test": "vitest",
    "e2e": "wdio run e2e/wdio.conf.ts",
    "e2e:docker": "docker compose -f docker-compose.e2e.yml run --build --rm e2e",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "*.{ts,mts}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-log": "2.9.0",
    "material-symbols": "0.45.10"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/types": "21.2.0",
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/mocha": "10.0.10",
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.10",
    "@wdio/cli": "9.30.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "@wdio/types": "9.30.1",
    "eslint": "10.8.1",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.5",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "webdriverio": "9.30.1"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
