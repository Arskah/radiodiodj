{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:js-app",
    "docker:enableMajor",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":automergeRequireAllStatusChecks",
    ":dependencyDashboard",
    ":label(dependencies)",
    ":maintainLockFilesWeekly",
    "security:minimumReleaseAgeNpm",
    ":disableRateLimiting"
  ],
  "timezone": "Europe/Helsinki",
  "postUpdateOptions": ["pnpmDedupe"],
  "minimumReleaseAge": "3 days",
  "semanticCommits": "enabled",
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "tauri build rejects a plugin's npm package and its Rust crate on different minors, and the plugins have no monorepo preset, so each plugin's two sides move in one PR. Core is left to the tauri monorepo preset",
      "matchManagers": ["npm", "cargo"],
      "matchPackageNames": ["tauri-plugin-*", "@tauri-apps/plugin-*"],
      "groupName": "{{{replace '^@tauri-apps/plugin-' 'tauri-plugin-' depName}}}"
    },
    {
      "description": "rusqlite_migration depends on rusqlite, and two rusqlite minors pull two libsqlite3-sys that both link sqlite3, which cargo rejects, so the two crates move in one PR",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["rusqlite", "rusqlite_migration"],
      "groupName": "rusqlite"
    }
  ]
}
